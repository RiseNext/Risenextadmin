# ---------- core ----------
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------- database ----------
DATABASE_URL=postgresql://risenext:risenext@localhost:5432/risenext?schema=public

# ---------- redis ----------
REDIS_URL=redis://localhost:6379

# ---------- auth ----------
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=15

# ---------- cloudinary ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DRIVER=cloudinary   # cloudinary | local
MAX_UPLOAD_MB=200

# ---------- email ----------
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Rise Next <hello@risenext.in>"

# ---------- whatsapp cloud api ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_NS=risenext

# ---------- ads / analytics ----------
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# ---------- backup ----------
BACKUP_DIR=./backups
BACKUP_CRON=0 3 * * *
